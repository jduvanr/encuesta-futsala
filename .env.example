# ── Supabase (Project Settings → API) ─────────────────────────────
# URL del proyecto
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Llave pública (anon / publishable). Solo puede INSERTAR gracias a RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Llave secreta (service_role / secret). SOLO servidor: la usa /admin para leer.
# Nunca le pongas el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Panel /admin ─────────────────────────────────────────────────
# Contraseña larga y única (mínimo 12 caracteres).
ADMIN_PASSWORD=cambia-esta-clave-por-una-larga

# ── Sitio ────────────────────────────────────────────────────────
# URL pública final, sin "/" al final. Se usa en Open Graph, el botón
# de compartir y el QR imprimible (npm run assets).
NEXT_PUBLIC_SITE_URL=https://encuesta.futsala.co
